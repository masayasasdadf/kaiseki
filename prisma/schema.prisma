// Kaiseki Analytics - Prisma Schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== Project Models =====

model Project {
  id             String   @id @default(cuid())
  name           String
  publicKey      String   @unique @default(cuid())
  secretKey      String   @unique
  allowedDomains String[] @default([])
  excludedIps    String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sessions      Session[]
  events        Event[]
  conversions   Conversion[]
  trackingRules TrackingRule[]
  auditLogs     AuditLog[]

  @@map("projects")
}

// ===== Analytics Models =====

model Session {
  id            String    @id @default(cuid())
  projectId     String
  visitorId     String
  sessionId     String    @unique
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  landingUrl    String?
  landingPath   String?
  referrer      String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  utmContent    String?
  utmTerm       String?
  gclid         String?
  fbclid        String?
  channelGroup  String    @default("Direct")
  country       String?
  device        String?
  browser       String?
  os            String?
  pageviewCount Int       @default(0)
  engaged       Boolean   @default(false)
  bounced       Boolean   @default(true)
  duration      Int       @default(0)
  maxScroll     Int       @default(0)

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pageviews PageView[]
  events    Event[]

  @@index([projectId, startedAt])
  @@index([projectId, channelGroup])
  @@index([visitorId])
  @@map("sessions")
}

model PageView {
  id        String   @id @default(cuid())
  projectId String
  sessionId String
  visitorId String
  path      String
  title     String?
  referrer  String?
  timestamp DateTime @default(now())
  duration  Int?

  session Session @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)

  @@index([projectId, timestamp])
  @@index([sessionId])
  @@map("pageviews")
}

model Event {
  id        String   @id @default(cuid())
  projectId String
  sessionId String
  visitorId String
  eventType String
  eventName String?
  path      String?
  props     Json?
  timestamp DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)

  @@index([projectId, timestamp])
  @@index([projectId, eventType, timestamp])
  @@index([sessionId])
  @@map("events")
}

model Conversion {
  id             String   @id @default(cuid())
  projectId      String
  sessionId      String
  visitorId      String
  trackingRuleId String?
  conversionName String
  path           String?
  props          Json?
  timestamp      DateTime @default(now())

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  trackingRule TrackingRule? @relation(fields: [trackingRuleId], references: [id])

  @@index([projectId, timestamp])
  @@index([sessionId])
  @@map("conversions")
}

model TrackingRule {
  id        String   @id @default(cuid())
  projectId String
  name      String
  type      String
  config    Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conversions Conversion[]
  auditLogs   AuditLog[]

  @@index([projectId])
  @@map("tracking_rules")
}

model AuditLog {
  id             String   @id @default(cuid())
  projectId      String
  trackingRuleId String?
  action         String
  actorEmail     String?
  details        Json?
  timestamp      DateTime @default(now())

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  trackingRule TrackingRule? @relation(fields: [trackingRuleId], references: [id])

  @@index([projectId, timestamp])
  @@map("audit_logs")
}
